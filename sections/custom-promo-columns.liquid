{% comment %}
  Section: Promo Columns
  Description: Two-column promotional image cards with overlay content.
{% endcomment %}
{{ 'section-custom-promo-columns.css' | asset_url | stylesheet_tag }}

<section id="promo-columns-{{ section.id }}" class="promo-columns page-width"
  style="
    --section-vertical-space: {{ section.settings.spacing_vertical }}px;
    --section-vertical-space-m: {{ section.settings.mobile_spacing_vertical }}px;
    --card-gap: {{ section.settings.column_gap }}px;
    --content-bg: {{ section.settings.content_bg }};
    --image-height-desktop: {{ section.settings.image_height_desktop }}px;
    --image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --mobile-gap: {{ section.settings.mobile_gap }}px;
  "
>
  <div class="promo-columns__container">
    <div class="promo-columns__grid">
      {% for block in section.blocks %}
        <div
          class="promo-columns__item promo-columns__item--{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <div class="promo-columns__media-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'promo-columns__image',
                  loading: 'lazy',
                  widths: '375, 550, 750, 1000, 1200',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  alt: block.settings.image.alt
              }}
            {% else %}
              <div class="promo-columns__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}

            <div class="promo-columns__content promo-columns__content--{{ block.settings.content_position }}">
              {% if block.settings.heading != blank %}
                <h3 class="promo-columns__heading">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="promo-columns__text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  class="promo-columns__button"
                  href="{{ block.settings.button_link | default: '#' }}"
                  {% if block.settings.open_new_tab %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}

              {% if block.settings.secondary_links != blank %}
                <div class="promo-columns__links">
                  {{ block.settings.secondary_links }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo columns",
  "tag": "section",
  "class": "section promo-columns-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content box background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image height desktop",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height mobile",
      "min": 260,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
        "type": "header",
        "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Promo columns gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
        "type": "range",
        "id": "spacing_vertical",
        "label": "Section vertical spacing (desktop)",
        "min": 0,
        "max": 120,
        "default": 40,
        "step": 4,
        "unit": "px"
    },
    {
        "type": "range",
        "id": "mobile_spacing_vertical",
        "label": "Section vertical spacing (mobile)",
        "min": 0,
        "max": 120,
        "default": 40,
        "step": 4,
        "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "promo_column",
      "name": "Promo column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Arrivals"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Our latest styles. Fresh. Fun. Fabulous.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary link label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open primary link in new tab",
          "default": false
        },
        {
          "type": "richtext",
          "id": "secondary_links",
          "label": "Secondary links",
          "info": "Use this for multiple links like Women | Men | Kids | Home."
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content box position",
          "default": "bottom",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "middle",
              "label": "Middle"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo columns",
      "blocks": [
        {
          "type": "promo_column",
          "settings": {
            "heading": "New Arrivals",
            "text": "<p>Our latest Summer styles. Fresh. Fun. Fabulous.</p>",
            "secondary_links": "<p><a href=\"#\">Women</a> | <a href=\"#\">Men</a> | <a href=\"#\">Kids</a> | <a href=\"#\">Home</a></p>",
            "content_position": "bottom"
          }
        },
        {
          "type": "promo_column",
          "settings": {
            "heading": "College Bound",
            "text": "<p>New places and new faces. Same great style.</p>",
            "button_label": "Shop Dorm Decor",
            "button_link": "#",
            "content_position": "bottom"
          }
        }
      ]
    }
  ]
}
{% endschema %}